{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["CLAUDE.md"],

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*.tfstate": "deny",
      "*.tfstate.backup": "deny",
      "secrets/**": "deny",
      "~/.aws/**": "deny",
      "~/.ssh/**": "deny"
    },

    "external_directory": {
      "~/.aws/**": "deny",
      "~/.ssh/**": "deny"
    },

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "gitleaks*": "allow",
      "semgrep*": "allow",
      "trivy*": "allow",
      "checkov*": "allow",
      "pip-audit*": "allow",
      "syft*": "allow",
      "docker build*": "allow",
      "docker compose config*": "allow",
      "terraform plan*": "allow",
      "terraform validate*": "allow",

      "git push --force*": "deny",
      "git push -f*": "deny",
      "git commit --no-verify*": "deny",
      "git commit -n*": "deny",
      "terraform apply -auto-approve*": "deny",
      "terraform destroy*": "deny",
      "docker run --privileged*": "deny",
      "rm -rf /*": "deny"
    }
  }
}
